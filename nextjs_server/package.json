{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "A complete Todo application with priority, recurring, reminders, subtasks, tags, templates, search, export/import, and calendar view",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:run": "vitest run",
    "test:all": "npm run test:unit:run && npm run test"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^9.0.0",
    "@simplewebauthn/server": "^9.0.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "next": "16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.8.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^9.0.0",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
