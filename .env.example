# Environment Variables Template
# Copy this to .env.local and update values

# JWT Secret - MUST change in production!
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-use-long-random-string

# Environment
NODE_ENV=development

# WebAuthn Configuration
# For local development
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_ORIGIN=http://localhost:3000

# For production, update these to your domain:
# NEXT_PUBLIC_RP_ID=yourdomain.com
# NEXT_PUBLIC_ORIGIN=https://yourdomain.com

# Notes:
# - RP_ID: Relying Party ID (domain without protocol or port)
# - ORIGIN: Full origin URL (protocol + domain + port if non-standard)
# - Both must match your actual deployment URL for WebAuthn to work
